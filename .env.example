# Copy this file to .env and fill in real values for local development.
# Production secrets must be injected via Docker secrets / Secret Manager / GitHub Secrets,
# never committed to the repository.

# -----------------------------------------------------------------------------
# Flask / Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
FLASK_DEBUG=1
# DISABLE_AUTH=1  # ONLY for local dev; never set in production

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: direct PostgreSQL connection (used by some admin/maintenance scripts)
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# OpenAI / LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-key
OPENAI_API_MODEL=gpt-4o-mini
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Option A: Traditional redis-py URL (used by Vibe stores and RQ worker).
REDIS_URL=redis://localhost:6379/0

# Option B: Upstash Redis REST (used by shared caches and Vibe state/events).
# RQ still requires REDIS_URL; without it, Vibe runs in a local background thread
# while sessions, runs, and streamed events remain shared through Upstash.
# UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# TradingView bridge
# -----------------------------------------------------------------------------
TRADINGVIEW_BRIDGE_URL=http://127.0.0.1:5002
USE_TRADINGVIEW=true

# -----------------------------------------------------------------------------
# Optional: proxies
# -----------------------------------------------------------------------------
# HTTP_PROXY=
# HTTPS_PROXY=
