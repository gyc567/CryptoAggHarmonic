# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Browser-visible backend base URL. Leave empty in local dev so the dashboard
# calls same-origin /api/* routes that next.config.mjs rewrites to the Flask
# backend. Set this only when the frontend must talk directly to a remote
# backend (e.g. Vercel → external API) and rewrites are not used.
NEXT_PUBLIC_API_BASE=

# Next.js server-side rewrite target (used by next.config.mjs). In local dev
# this points to the Flask backend started by scripts/start-backend.sh.
BACKEND_API_BASE=http://127.0.0.1:5000
